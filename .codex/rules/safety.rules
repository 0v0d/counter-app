# Codex の execpolicy ルール
# 破壊的な操作は禁止し、外部や履歴に影響する操作は承認制にする。
# 通常のローカル開発コマンドはサンドボックス内でそのまま動かす。
#
# 複数のルールに一致した場合は最も厳しい判定（forbidden > prompt > allow）が採用される。
# パターンは先頭一致のため、後ろに付いたオプション（例: git push origin main --force）は検出できない。

# --- 禁止 ---
prefix_rule(
    pattern = ["sudo"],
    decision = "forbidden",
    justification = "権限昇格は禁止しています。必要な場合は手動で実行してください。",
)

prefix_rule(
    pattern = ["su"],
    decision = "forbidden",
    justification = "ユーザーの切り替えは禁止しています。",
)

prefix_rule(
    pattern = ["rm", ["-rf", "-fr", "-Rf", "-rF"]],
    decision = "forbidden",
    justification = "強制的な再帰削除は禁止しています。削除するファイルやディレクトリを個別に指定してください。",
)

prefix_rule(
    pattern = ["dd"],
    decision = "forbidden",
    justification = "ブロック単位のコピーはデータを破壊する恐れがあるため禁止しています。",
)

prefix_rule(
    pattern = [["mkfs", "mkfs.ext4", "mkfs.xfs", "mkfs.btrfs"]],
    decision = "forbidden",
    justification = "ファイルシステムのフォーマットは破壊的なため禁止しています。",
)

prefix_rule(
    pattern = [["shutdown", "reboot", "halt", "poweroff"]],
    decision = "forbidden",
    justification = "システムの電源操作は禁止しています。",
)

prefix_rule(
    pattern = ["chmod", "777"],
    decision = "forbidden",
    justification = "誰でも書き込める権限の付与は禁止しています。必要最小限の権限を指定してください。",
)

prefix_rule(
    pattern = ["git", "reset", "--hard"],
    decision = "forbidden",
    justification = "未コミットの変更が失われるため禁止しています。--hard 以外の reset を使ってください。",
)

prefix_rule(
    pattern = ["git", "clean"],
    decision = "forbidden",
    justification = "追跡していないファイルが完全に削除されるため禁止しています。",
)

prefix_rule(
    pattern = ["git", "push", ["--force", "-f", "--force-with-lease", "--delete", "-d", "--mirror", "--prune"]],
    decision = "forbidden",
    justification = "リモートの履歴を書き換える、またはブランチを削除する push は禁止しています。",
)

prefix_rule(
    pattern = ["git", "push", "origin", ["--force", "-f", "--force-with-lease", "--delete", "-d", "--mirror", "--prune"]],
    decision = "forbidden",
    justification = "リモートの履歴を書き換える、またはブランチを削除する push は禁止しています。",
)

prefix_rule(
    pattern = ["gh", "repo", "delete"],
    decision = "forbidden",
    justification = "リポジトリの削除は破壊的なため禁止しています。",
)

prefix_rule(
    pattern = ["gh", "pr", "merge"],
    decision = "forbidden",
    justification = "PR のマージはレビュー後に手動で行ってください。",
)

# --- 自動で許可（サンドボックス外で実行） ---
prefix_rule(
    pattern = ["git", "push"],
    decision = "allow",
    justification = "push は認証情報とネットワークが必要なため、サンドボックス外で確認なしに実行します。main は GitHub のルールセットで強制 push・削除・直接 push から保護されています。",
)

# --- 承認が必要 ---
prefix_rule(
    pattern = ["git", "commit"],
    decision = "prompt",
    justification = "コミットは履歴を変更し、pre-commit フックで Gradle も実行されるため承認が必要です。",
)

prefix_rule(
    pattern = ["git", "checkout", ["--", "."]],
    decision = "prompt",
    justification = "未コミットの変更が失われる可能性があるため承認が必要です。",
)

prefix_rule(
    pattern = ["git", "restore"],
    decision = "prompt",
    justification = "未コミットの変更が失われる可能性があるため承認が必要です。",
)

prefix_rule(
    pattern = ["git", "stash", ["drop", "clear"]],
    decision = "prompt",
    justification = "退避した変更が失われるため承認が必要です。",
)

prefix_rule(
    pattern = ["git", "branch", ["-D", "--delete"]],
    decision = "prompt",
    justification = "ブランチの削除は承認が必要です。",
)

prefix_rule(
    pattern = ["rm", ["-r", "-R", "--recursive"]],
    decision = "prompt",
    justification = "再帰的な削除は対象を確認してから実行してください。",
)

prefix_rule(
    pattern = [["curl", "wget", "http", "https", "httpie"]],
    decision = "prompt",
    justification = "外部にデータを送る可能性があるため、送信先と内容を確認してください。",
)

prefix_rule(
    pattern = [["ssh", "scp", "sftp", "rsync", "nc", "ncat", "netcat", "socat"]],
    decision = "prompt",
    justification = "リモート接続やネットワーク操作は承認が必要です。",
)

prefix_rule(
    pattern = ["gh", "api"],
    decision = "prompt",
    justification = "GitHub API はリモートの状態を読み書きする可能性があるため、実行前に確認してください。",
)

prefix_rule(
    pattern = ["gh", ["secret", "variable"]],
    decision = "prompt",
    justification = "GitHub の Secret・Variable の操作は機密情報の漏洩や変更につながる可能性があります。",
)

prefix_rule(
    pattern = ["npm", ["install", "i", "ci"]],
    decision = "prompt",
    justification = "依存関係のインストールはライフサイクルスクリプトを実行し、lock ファイルを変更する可能性があります。",
)

prefix_rule(
    pattern = ["yarn", ["install", "add"]],
    decision = "prompt",
    justification = "依存関係のインストールはライフサイクルスクリプトを実行し、lock ファイルを変更する可能性があります。",
)

prefix_rule(
    pattern = ["pnpm", ["install", "add"]],
    decision = "prompt",
    justification = "依存関係のインストールはライフサイクルスクリプトを実行し、lock ファイルを変更する可能性があります。",
)

prefix_rule(
    pattern = ["bun", ["install", "add"]],
    decision = "prompt",
    justification = "依存関係のインストールはライフサイクルスクリプトを実行し、lock ファイルを変更する可能性があります。",
)

prefix_rule(
    pattern = [["pip", "pip3"], ["install", "uninstall"]],
    decision = "prompt",
    justification = "Python パッケージの変更は承認が必要です。",
)

prefix_rule(
    pattern = ["gem", ["install", "uninstall", "update"]],
    decision = "prompt",
    justification = "Ruby パッケージの変更は承認が必要です。",
)

prefix_rule(
    pattern = ["cargo", ["install", "uninstall"]],
    decision = "prompt",
    justification = "Cargo パッケージのインストール・削除は承認が必要です。",
)

prefix_rule(
    pattern = ["go", "install"],
    decision = "prompt",
    justification = "Go ツールのインストールはローカル環境を変更するため承認が必要です。",
)

prefix_rule(
    pattern = [["brew", "apt", "apt-get", "dnf", "yum", "pacman", "snap"]],
    decision = "prompt",
    justification = "システムのパッケージ管理は承認が必要です。",
)

prefix_rule(
    pattern = [["docker", "podman"]],
    decision = "prompt",
    justification = "コンテナ操作はファイルのマウントやネットワーク接続、永続的な状態の変更を伴う可能性があります。",
)

prefix_rule(
    pattern = [["kubectl", "helm", "terraform"]],
    decision = "prompt",
    justification = "インフラ操作はリモートや本番のリソースを変更する可能性があります。",
)

prefix_rule(
    pattern = [["aws", "gcloud", "az", "firebase", "vercel", "netlify", "heroku"]],
    decision = "prompt",
    justification = "クラウド・デプロイ操作はリモートのリソースを変更する可能性があるため承認が必要です。",
)
