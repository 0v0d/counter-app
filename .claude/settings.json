{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "sandbox": {
        "enabled": true,
        "allowUnsandboxedCommands": false,
        "autoAllowBashIfSandboxed": true,
        "filesystem": {
            "allowWrite": [
                "~/.gradle",
                "~/.android",
                "~/.m2/repository",
                "~/Library/Application Support/kotlin"
            ],
            "denyWrite": [
                "**/.env*",
                "**/secrets/**",
                "**/*secret*",
                "**/*credential*",
                "**/*token*",
                "**/*APIKey*",
                "**/*apikey*",
                "**/*.p12",
                "**/*.p8",
                "**/*.cer",
                "**/*.pem",
                "**/*.key",
                "**/*.gpg",
                "**/*.asc",
                "**/*.keystore",
                "**/*.jks",
                "**/.netrc",
                "**/.npmrc",
                "**/.pypirc",
                "**/.claude/settings.json",
                "**/.claude/settings.local.json"
            ],
            "denyRead": [
                "**/.env*",
                "**/secrets/**",
                "**/*secret*",
                "**/*credential*",
                "**/*token*",
                "**/*APIKey*",
                "**/*apikey*",
                "**/*.p12",
                "**/*.p8",
                "**/*.cer",
                "**/*.pem",
                "**/*.key",
                "**/*.gpg",
                "**/*.asc",
                "**/*.keystore",
                "**/*.jks",
                "**/.netrc",
                "**/.npmrc",
                "**/.pypirc",
                "**/.DS_Store",
                "**/*.log",
                "~/.ssh/**",
                "~/.aws/**",
                "~/.gcp/**",
                "~/.config/gh/**",
                "~/.netrc",
                "~/.npmrc",
                "~/.docker/config.json",
                "~/.zsh_history",
                "~/.bash_history",
                "~/Library/Keychains/**",
                "~/.gnupg/**",
                "/etc/passwd",
                "/etc/shadow"
            ]
        },
        "excludedCommands": [
            "git status",
            "git diff *",
            "git push *",
            "git pull *",
            "git fetch *",
            "git branch *",
            "git checkout *",
            "git commit *",
            "git reset *",
            "git add *"
        ]
    },
    "env": {
        "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "1",
        "DISABLE_FEEDBACK_COMMAND": "1",
        "DISABLE_ERROR_REPORTING": "1"
    },
    "permissions": {
        "allow": [
            "WebFetch(domain:github.com)",
            "Bash(git status)",
            "Bash(git diff *)",
            "Bash(git log *)",
            "Bash(git branch *)",
            "Bash(git checkout *)",
            "Bash(git pull *)",
            "Bash(git fetch *)",
            "Bash(git show *)",
            "Bash(ls *)",
            "Bash(find *)",
            "Bash(grep *)",
            "Bash(egrep *)",
            "Bash(fgrep *)",
            "Bash(rg *)",
            "Bash(which *)",
            "Bash(echo *)",
            "Bash(date *)",
            "Bash(pwd)",
            "Bash(./Scripts/*)",
            "Bash(./scripts/*)",
            "Read(~/.zshrc)",
            "Read(~/.bashrc)",
            "Read(../docs/*)",
            "Write(../docs/*)",
            "Edit(../docs/*)",
            "Read(**/.claude/**)",
            "Read(**/.github/**)",
            "Edit(**/.claude/**)",
            "Write(**/.claude/**)",
            "Read(./.gitignore)"
        ],
        "deny": [
            "Bash(rm *)",
            "Bash(mv *)",
            "Bash(chmod 777 *)",
            "Bash(sudo *)",
            "Bash(dd *)",
            "Bash(eval *)",
            "Bash(exec *)",
            "Bash(source *)",
            "Bash(. *)",
            "Bash(sh *)",
            "Bash(bash *)",
            "Bash(zsh *)",
            "Bash(ksh *)",
            "Bash(dash *)",
            "Bash(fish *)",
            "Bash(bash -c *)",
            "Bash(sh -c *)",
            "Bash(/bin/sh*)",
            "Bash(/bin/bash*)",
            "Bash(/bin/zsh*)",
            "Bash(/usr/bin/sh*)",
            "Bash(/usr/bin/bash*)",
            "Bash(/usr/bin/zsh*)",
            "Bash(/usr/bin/env *)",
            "Bash(command *)",
            "Bash(xargs *)",
            "Bash(parallel *)",
            "Bash(nohup *)",
            "Bash(setsid *)",
            "Bash(at *)",
            "Bash(batch *)",
            "Bash(crontab *)",
            "Bash(curl *)",
            "Bash(wget *)",
            "Bash(nc *)",
            "Bash(ncat *)",
            "Bash(netcat *)",
            "Bash(ssh *)",
            "Bash(scp *)",
            "Bash(sftp *)",
            "Bash(ftp *)",
            "Bash(tftp *)",
            "Bash(telnet *)",
            "Bash(socat *)",
            "Bash(httpie *)",
            "Bash(http *)",
            "Bash(https *)",
            "Bash(aria2c *)",
            "Bash(axel *)",
            "Bash(mosh *)",
            "Bash(rsync *)",
            "Bash(env)",
            "Bash(env *)",
            "Bash(set)",
            "Bash(declare *)",
            "Bash(typeset *)",
            "Bash(export *)",
            "Bash(printenv)",
            "Bash(gh auth token*)",
            "Bash(gh secret *)",
            "Bash(gh variable *)",
            "Bash(security *)",
            "Bash(gpg *)",
            "Bash(gpg2 *)",
            "Bash(openssl *)",
            "Bash(ssh-add *)",
            "Bash(ssh-keygen *)",
            "Bash(ssh-agent *)",
            "Bash(gh api -X POST *)",
            "Bash(gh api -XPOST*)",
            "Bash(gh api --method POST *)",
            "Bash(gh api --method=POST*)",
            "Bash(gh api -X PATCH *)",
            "Bash(gh api -XPATCH*)",
            "Bash(gh api --method PATCH *)",
            "Bash(gh api --method=PATCH*)",
            "Bash(gh api -X PUT *)",
            "Bash(gh api -XPUT*)",
            "Bash(gh api --method PUT *)",
            "Bash(gh api --method=PUT*)",
            "Bash(gh api -X DELETE *)",
            "Bash(gh api -XDELETE*)",
            "Bash(gh api --method DELETE *)",
            "Bash(gh api --method=DELETE*)",
            "Bash(gh api repos/*/contents/*)",
            "Bash(gh repo delete *)",
            "Bash(gh pr merge *)",
            "Bash(git clean *)",
            "Bash(git checkout .)",
            "Bash(git checkout -- .)",
            "Bash(git restore .)",
            "Bash(git show *:*.env*)",
            "Bash(git show *:*secret*)",
            "Bash(git show *:*credential*)",
            "Bash(git show *:*token*)",
            "Bash(git show *:*.pem)",
            "Bash(git show *:*.key)",
            "Bash(find * -exec *)",
            "Bash(find * -execdir *)",
            "Bash(find * -delete*)",
            "Bash(osascript *)",
            "Bash(automator *)",
            "Bash(applescript *)",
            "Bash(launchctl *)",
            "Bash(defaults *)",
            "Bash(dscl *)",
            "Bash(hdiutil *)",
            "Bash(screencapture *)",
            "Bash(pbcopy *)",
            "Bash(pbpaste *)",
            "Bash(brew *)",
            "Bash(apt *)",
            "Bash(apt-get *)",
            "Bash(snap *)",
            "Bash(gdb *)",
            "Bash(lldb *)",
            "Bash(dtrace *)",
            "Bash(../*)",
            "Bash(~/*)"
        ],
        "ask": [
            "Bash(git reset *)",
            "Bash(git add *)",
            "Bash(git commit *)",
            "Bash(git restore *)",
            "Bash(chmod *)",
            "Write(**/.github/**)",
            "Edit(**/.github/**)",
            "Bash(npm install)",
            "Bash(npm install *)",
            "Bash(npm i)",
            "Bash(npm i *)",
            "Bash(npm ci)",
            "Bash(npm ci *)",
            "Bash(yarn install)",
            "Bash(yarn install *)",
            "Bash(yarn)",
            "Bash(gem install *)",
            "Bash(gem update *)",
            "Bash(bundle install)",
            "Bash(bundle install *)",
            "Bash(bundle update)",
            "Bash(bundle update *)",
            "Bash(bundle)",
            "Bash(composer install)",
            "Bash(composer install *)",
            "Bash(composer update)",
            "Bash(composer update *)",
            "Bash(cargo install *)",
            "Bash(go install *)",
            "Bash(gzip *)",
            "Bash(gunzip *)",
            "Bash(bzip2 *)",
            "Bash(bunzip2 *)",
            "Bash(xz *)",
            "Bash(unxz *)",
            "Bash(compress *)",
            "Bash(uncompress *)",
            "Bash(lz4 *)",
            "Bash(zstd *)",
            "Bash(7z *)",
            "Bash(7za *)",
            "Bash(7zr *)",
            "Bash(rar *)",
            "Bash(unrar *)",
            "Bash(aws *)",
            "Bash(gcloud *)",
            "Bash(az *)",
            "Bash(heroku *)",
            "Bash(firebase *)",
            "Bash(terraform *)",
            "Bash(kubectl *)",
            "Bash(docker *)",
            "Bash(podman *)",
            "Bash(vercel *)",
            "Bash(netlify *)"
        ],
        "disableBypassPermissionsMode": "disable"
    }
}